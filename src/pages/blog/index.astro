---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmt } from '../../lib/fmt';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base post title="blog // lycoris">
  <section id="post">
    <article>
      <a class="back" href={`${base}/`}>&lt; back</a>
      <h1>all my posts</h1>
      <div class="tag-cloud">{tags.map((t) => <a href={`${base}/tags/${t}/`}>#{t}</a>)}</div>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={`${base}/blog/${p.id}/`}>{p.data.title}</a>
            <small>{fmt(p.data.date)} // {p.data.tags.map((t) => '#' + t).join(' ')}</small>
          </li>
        ))}
      </ul>
    </article>
  </section>
</Base>
