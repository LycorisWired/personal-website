---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmt } from '../../lib/fmt';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth <= 3);
---
<Base post title={`${entry.data.title} // lycoris`} description={entry.data.description}>
  <section id="post">
    <article>
      <a class="back" href={`${base}/`}>&lt; back</a>
      <h1>{entry.data.title}</h1>
      <div class="tag-cloud">
        <span>{fmt(entry.data.date)}</span>
        {entry.data.tags.map((t) => <a href={`${base}/tags/${t}/`}>#{t}</a>)}
      </div>
      {toc.length > 1 && (
        <nav aria-label="Contents">
          {toc.map((h) => <a href={`#${h.slug}`} style={`padding-left:${(h.depth - 2) * 14}px`}>{h.text}</a>)}
        </nav>
      )}
      <Content />
    </article>
  </section>
</Base>
