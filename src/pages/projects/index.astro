---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base post title="projects // lycoris" description="Labs and software projects.">
  <section id="post">
    <article>
      <a class="back" href={`${base}/`}>&lt; back</a>
      <h1>projects</h1>
      <div class="page-nav"><a href={`${base}/blog/`}>→ blog</a></div>
      <ul class="project-list">
        {projects.map((p) => (
          <li class="proj">
            <h2>
              {p.data.title}
              <span class="status">{p.data.status}</span>
            </h2>
            <p>{p.data.summary}</p>
            <div class="chips">{p.data.stack.map((s) => <span>{s}</span>)}</div>
            {p.data.links.length > 0 && (
              <div class="project-links">
                {p.data.links.map((l) => <a href={l.url}>{l.label}</a>)}
              </div>
            )}
        </li>
        ))}
      </ul>
    </article>
  </section>
</Base>
